# Server-only. Set these in the Vercel project (Production and Preview).
# Never prefix them with NEXT_PUBLIC_. The anon and service-role keys must not
# appear in client code. GitHub Pages does not read this file and cannot run the app.
#
# DATABASE_URL — optional. The Vercel demo runs without it.
#   Supabase transaction pooler, port 6543, when you have a hosted database.
#   postgres.js uses prepare: false.
# DIRECT_DATABASE_URL — migrations only (`npm run db:migrate`), port 5432.
#   Not required at runtime. The migrate script falls back to DATABASE_URL.
# SEED_ILLUSTRATIVE — set to true once if the hosted database should receive the
#   fictional demo corpus. Analytical mode still excludes those rows.
#   Leave unset on a database that should stay empty until real imports exist.
#
# When DATABASE_URL is unset, local `next dev` uses data/sandbox (PGlite).
# On Vercel the same situation serves the bundled illustrative corpus in memory.
# No disk database and no API key. Set PW_STORE=memory to force that path locally,
# or PW_STORE=pglite to force the sandbox on Vercel.

DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Not read yet. Reserved for a later server-side Supabase client.
# SUPABASE_URL=https://[project-ref].supabase.co
# SUPABASE_SECRET_KEY=

# SEED_ILLUSTRATIVE=true
